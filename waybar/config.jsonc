{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 32,
  "modules-left": ["custom/launcher", "custom/separator", "clock", "mpris"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "group/tray-expander",
    "idle_inhibitor",
    "custom/updatespacman",
    "network",
    "bluetooth",
    "backlight",
    "wireplumber",
    "power-profiles-daemon",
    "cpu",
    "memory",
    "battery",
  ],

  // ── Workspaces ────────────────────────────────────────────────────────────
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "tooltip": false,
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
    "format-icons": {
      "default": "",
      "active": "󰀥",
      "empty": "",
      "focused": "",
    },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5],
    },
  },

  // ── App launcher (replaces custom/omarchy) ────────────────────────────────
  "custom/launcher": {
    "format": "󰀘",
    "on-click": "wofi --show drun",
    "on-click-right": "kitty",
    "tooltip-format": "App Launcher\n\nRight-click: Terminal",
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false,
  },

  // ── Power profiles ────────────────────────────────────────────────────────
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },

  // ── CPU ───────────────────────────────────────────────────────────────────
  "cpu": {
    "interval": 10,
    "format": "cpu {usage}%",
    "on-click": "kitty -e btop",
  },

  "memory": {
    "interval": 5,
    //"format": " {percentage}%",
    "format": "mem {percentage}%",
    "tooltip-format": "Used: {used:.1f}G / {total:.1f}G\nAvailable: {avail:.1f}G",
    "on-click": "kitty -e btop",
  },

  // ── Backlight ─────────────────────────────────────────────────────────────
  "backlight": {
    // "device": "nvidia_wmi_ec_backlight",
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip-format": "{percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
  },

  // ── Clock ─────────────────────────────────────────────────────────────────
  "clock": {
    "format": "{:%b %d | %I:%M %p}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "timezone": "PST8PDT",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
  },

  // ── Idle inhibitor ────────────────────────────────────────────────────────
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
  },

  // ── Network ───────────────────────────────────────────────────────────────
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click-right": "nm-connection-editor",
  },

  // ── Battery ───────────────────────────────────────────────────────────────
  "battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "format-full": "󰂅 {capacity}%",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {timeTo}",
    "tooltip-format-charging": "{power:>1.0f}W↑ {timeTo}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10,
    },
  },

  // ── Bluetooth ─────────────────────────────────────────────────────────────
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager",
    "on-click-right": "kitty --class=bluetooth-manager -e bluetoothctl",
  },

  // ── Audio (WirePlumber — replaces pulseaudio, no pamixer needed) ──────────
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 5,
    "smooth-scrolling-threshold": 1,
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
    "max-volume": 150,
  },

  // ── Tray expander drawer ──────────────────────────────────────────────────
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray", "custom/separator"],
  },

  "custom/expand-icon": {
    "format": " ",
    "tooltip": false,
  },

  // ── Media (mpris) ─────────────────────────────────────────────────────────
  "mpris": {
    "format": "  {artist} - {title}",
    "format-paused": "<span color='grey'>{status_icon}  {title}</span>",
    "max-length": 55,
    "player-icons": {
      "default": "⏸",
      "mpv": "🎵",
      "firefox": "",
      "chromium": "",
      "brave": "",
      "helium-browser": "",
    },
    "status-icons": {
      "paused": "󰝛",
    },
    "ignored-players": ["playerctld"],
  },

  // ── System tray ───────────────────────────────────────────────────────────
  "tray": {
    "icon-size": 12,
    "spacing": 12,
  },
}
